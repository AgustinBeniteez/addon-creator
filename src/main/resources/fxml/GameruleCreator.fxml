<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.agustinbenitez.addoncreator.ui.GameruleCreatorController"
            styleClass="item-creator-root" stylesheets="@../css/item-creator.css" style="-fx-background-color: #1e1e1e; -fx-text-fill: white; -fx-min-width: 500; -fx-min-height: 400;">
    
    <top>
        <VBox spacing="10" style="-fx-padding: 20;">
            <Label text="Create Custom Gamerule" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20"/>
                </font>
            </Label>
            <Label text="Generates a script to manage a custom gamerule using Dynamic Properties." textFill="#aaaaaa"/>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="20" style="-fx-padding: 0 20 20 20;">
            <VBox spacing="5">
                <Label text="Gamerule Identifier:" styleClass="item-creator-label"/>
                <TextField fx:id="identifierField" promptText="e.g. enablePVP"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Type:" styleClass="item-creator-label"/>
                <ComboBox fx:id="typeCombo" maxWidth="Infinity"/>
            </VBox>
            
            <VBox spacing="5" fx:id="defaultValueBox">
                <Label text="Default Value:" styleClass="item-creator-label"/>
                <!-- Will be populated dynamically based on type -->
                <TextField fx:id="defaultValueField"/>
                <CheckBox fx:id="defaultBoolCheck" text="True" visible="false" managed="false"/>
            </VBox>
        </VBox>
    </center>
    
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 20;">
            <Button text="Cancel" onAction="#handleCancel" styleClass="item-creator-button"/>
            <Button fx:id="createButton" text="Create Gamerule" onAction="#handleCreate" styleClass="item-creator-primary-button"/>
        </HBox>
    </bottom>
    
</BorderPane>