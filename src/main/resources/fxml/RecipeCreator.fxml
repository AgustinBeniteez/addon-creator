<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.agustinbenitez.addoncreator.ui.RecipeCreatorController"
      spacing="20" styleClass="recipe-creator-root" stylesheets="@../css/recipe-creator.css"
      style="-fx-padding: 20; -fx-min-width: 800; -fx-min-height: 600;">

    <!-- Header -->
    <Label text="Recipe Creator" styleClass="recipe-creator-title"/>

    <Separator/>

    <!-- Settings Form -->
    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints minWidth="120" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Identifier:" styleClass="recipe-creator-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="identifierField" promptText="namespace:recipe_name" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Description:" styleClass="recipe-creator-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="descriptionField" promptText="Recipe Identifier" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Group (Optional):" styleClass="recipe-creator-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="groupField" promptText="item_group" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Type:" styleClass="recipe-creator-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="typeCombo" promptText="Select Type" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <Separator/>

    <!-- Recipe Grid Area -->
    <HBox spacing="40" alignment="CENTER" VBox.vgrow="ALWAYS">
        <!-- Crafting Grid -->
        <VBox spacing="5" alignment="CENTER">
            <Label text="Pattern" styleClass="recipe-creator-label"/>
            <GridPane fx:id="craftingGrid" hgap="5" vgap="5" style="-fx-padding: 10; -fx-background-color: #2d2d30; -fx-background-radius: 5; -fx-border-color: #555; -fx-border-radius: 5;">
                <!-- 3x3 Grid generated in Controller -->
            </GridPane>
        </VBox>

        <!-- Arrow -->
        <SVGPath content="M 0 0 L 20 10 L 0 20 L 5 10 Z" fill="#888888" scaleX="2" scaleY="2"/>

        <!-- Result -->
        <VBox spacing="5" alignment="CENTER">
            <Label text="Result" styleClass="recipe-creator-label"/>
            <Button fx:id="resultSlot" prefWidth="64" prefHeight="64" styleClass="slot-button"/>
            <HBox spacing="5" alignment="CENTER">
                <Label text="Count:" styleClass="recipe-creator-label"/>
                <Spinner fx:id="resultCount" prefWidth="80" editable="true"/>
            </HBox>
        </VBox>
    </HBox>

    <Separator/>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Preview JSON" onAction="#handlePreview" styleClass="recipe-creator-button"/>
        <Button fx:id="createButton" text="Create Recipe" onAction="#handleCreate" styleClass="recipe-creator-primary-button"/>
    </HBox>

</VBox>
