<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.agustinbenitez.addoncreator.ui.ItemCreatorController"
      spacing="20" styleClass="item-creator-root" stylesheets="@../css/item-creator.css"
      style="-fx-padding: 20; -fx-min-width: 950; -fx-min-height: 600;">

    <!-- Header -->
    <Label text="ITEM CREATOR" styleClass="item-creator-title"/>

    <!-- Main Content Area (Split) -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        
        <!-- LEFT: Form Area -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" HBox.hgrow="ALWAYS">
            <content>
                <VBox spacing="20" styleClass="item-creator-settings">
                    
                    <!-- General Info -->
                    <TitledPane text="General Information" collapsible="false" expanded="true">
                        <GridPane hgap="15" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <Label text="Identifier:" styleClass="item-creator-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="identifierField" promptText="namespace:item_name" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="e.g., myaddon:ruby_sword" styleClass="item-creator-instruction" style="-fx-text-fill: #888888; -fx-font-size: 10;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Display Name:" styleClass="item-creator-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="nameField" promptText="Ruby Sword" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        </GridPane>
                    </TitledPane>

                    <!-- Visuals -->
                    <TitledPane text="Visuals" collapsible="false" expanded="true">
                        <GridPane hgap="15" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <Label text="Texture / Icon:" styleClass="item-creator-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <Button fx:id="textureButton" text="Select Texture" onAction="#handleSelectTexture" styleClass="item-creator-button"/>
                                <StackPane fx:id="texturePreviewPane" prefWidth="32" prefHeight="32" styleClass="item-creator-texture-box">
                                    <ImageView fx:id="texturePreview" fitWidth="32" fitHeight="32" preserveRatio="true"/>
                                </StackPane>
                                <Label fx:id="textureNameLabel" text="None selected" styleClass="item-creator-info-text"/>
                            </HBox>

                            <Label text="Glint (Enchanted):" styleClass="item-creator-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <CheckBox fx:id="glintCheck" text="Has Glint Effect" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        </GridPane>
                    </TitledPane>

                    <!-- Properties -->
                    <TitledPane text="Properties" collapsible="false" expanded="true">
                        <GridPane hgap="15" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <Label text="Max Stack Size:" styleClass="item-creator-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Spinner fx:id="stackSizeSpinner" editable="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Hand Equipped:" styleClass="item-creator-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <CheckBox fx:id="handEquippedCheck" text="Held like a tool" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            
                            <Label text="Damage (Attack):" styleClass="item-creator-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Spinner fx:id="damageSpinner" editable="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        </GridPane>
                    </TitledPane>

                    <!-- Food -->
                    <TitledPane text="Food Properties" collapsible="false" expanded="true">
                        <VBox spacing="10">
                            <CheckBox fx:id="isFoodCheck" text="Is Food Item?"/>
                            
                            <GridPane fx:id="foodGrid" hgap="15" vgap="15" disable="true">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="150" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                </columnConstraints>

                                <Label text="Nutrition:" styleClass="item-creator-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Spinner fx:id="nutritionSpinner" editable="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Saturation:" styleClass="item-creator-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <ComboBox fx:id="saturationCombo" promptText="Select Saturation" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Can Always Eat:" styleClass="item-creator-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <CheckBox fx:id="canAlwaysEatCheck" text="Allow eating when full" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </GridPane>
                        </VBox>
                    </TitledPane>

                </VBox>
            </content>
        </ScrollPane>

        <!-- RIGHT: Preview Panel -->
        <VBox spacing="15" minWidth="250" prefWidth="300" styleClass="item-creator-preview-panel">
            
            <!-- Texture Preview Box -->
            <VBox alignment="CENTER" spacing="5">
                <StackPane prefWidth="128" prefHeight="128" styleClass="item-creator-texture-box">
                    <ImageView fx:id="largeTexturePreview" fitWidth="100" fitHeight="100" preserveRatio="true"/>
                </StackPane>
                <Label text="Item texture" styleClass="item-creator-preview-label"/>
            </VBox>

            <Separator/>
            
            <Label text="info preview" styleClass="item-creator-preview-info-label"/>
            
            <VBox spacing="8" style="-fx-padding: 10 0 0 10;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="name" styleClass="item-creator-info-text" minWidth="50"/>
                    <Label fx:id="previewNameLabel" text="..." styleClass="item-creator-value-text" wrapText="true"/>
                </HBox>
                
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="stack" styleClass="item-creator-info-text" minWidth="50"/>
                    <Label fx:id="previewStackLabel" text="64" styleClass="item-creator-value-text"/>
                </HBox>
                
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="ID" styleClass="item-creator-info-text" minWidth="50"/>
                    <Label fx:id="previewIdLabel" text="..." styleClass="item-creator-value-text" wrapText="true" style="-fx-font-family: 'Consolas', monospace;"/>
                </HBox>
            </VBox>

        </VBox>
    </HBox>

    <Separator/>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="item-creator-button"/>
        <Button text="Create Item" onAction="#handleCreate" styleClass="item-creator-primary-button"/>
    </HBox>

</VBox>
