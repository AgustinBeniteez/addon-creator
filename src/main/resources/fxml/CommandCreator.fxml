<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.agustinbenitez.addoncreator.ui.CommandCreatorController"
            styleClass="item-creator-root" stylesheets="@../css/item-creator.css" style="-fx-background-color: #1e1e1e; -fx-text-fill: white; -fx-min-width: 500; -fx-min-height: 400;">
    
    <top>
        <VBox spacing="10" style="-fx-padding: 20;">
            <Label text="Create Custom Command" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20"/>
                </font>
            </Label>
            <Label text="Generates a script to handle a custom chat command." textFill="#aaaaaa"/>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="20" style="-fx-padding: 0 20 20 20;">
            <VBox spacing="5">
                <Label text="Command Name (without /):" styleClass="item-creator-label"/>
                <TextField fx:id="nameField" promptText="e.g. warp"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Description:" styleClass="item-creator-label"/>
                <TextField fx:id="descriptionField" promptText="Teleports the player"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Permission Level:" styleClass="item-creator-label"/>
                <ComboBox fx:id="permissionCombo" maxWidth="Infinity"/>
            </VBox>
            
            <CheckBox fx:id="adminOnlyCheck" text="Admin Only (Tag: 'admin')" textFill="WHITE"/>
        </VBox>
    </center>
    
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 20;">
            <Button text="Cancel" onAction="#handleCancel" styleClass="item-creator-button"/>
            <Button fx:id="createButton" text="Create Command" onAction="#handleCreate" styleClass="item-creator-primary-button"/>
        </HBox>
    </bottom>
    
</BorderPane>